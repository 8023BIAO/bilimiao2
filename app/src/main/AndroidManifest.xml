<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!--
      下载写公共目录 Download/BiliMiao 用的权限：
      Android 10（API 29）及以上走 MediaStore，**不需要**这个权限（也不弹框）；
      只有 Android 9 及以下才需要，所以用 maxSdkVersion=28 把它限制在老系统上。
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 下载服务以 dataSync 类型常驻前台，Android 14+ 需要单独声明该类型的权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />


    <application
        android:name=".Bilimiao"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:allowNativeHeapPointerTagging="false"
        android:icon="@mipmap/ic_bilimiao_33"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_bilimiao_33_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bilimiao"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true">
        <!-- 渠道 -->
        <meta-data
            android:name="app_channel"
            android:value="${channel}" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="bilibili" />
                <data android:scheme="bilimiao" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.LogViewerActivity"
            android:label="@string/log_viewer"
            android:theme="@style/Theme.Bilimiao"/>
        <activity
            android:name="cn.a10miaomiao.bilimiao.cover.CoverActivity"
            android:exported="false"
            android:label="@string/view_cover"
            android:theme="@style/Theme.TranslucentTheme" />

        <!--
          直播播放页（第二阶段 A 路新增，独立 Activity，roomId 走 Intent extra）。
          为什么是独立 Activity：见方案 §3.3 —— 点播播放器 PlayerDelegate2 是 MainActivity 的单例，禁改。
          · supportsPictureInPicture：直播的画中画
          · configChanges 里的 orientation|screenSize|... ：转屏/进出 PiP 不重建 Activity
            （重建会连 ExoPlayer 一起重建 → 直播必然黑屏闪一下，不能接受）
            ★这一组必须与另外两个宿主（MainActivity :46 / VideoPlayerActivity :107）**逐字一致**：
            少一个 token（原来少了 `keyboard`）= 该配置变化时系统**销毁重建本页**，
            本页的 ExoPlayer / TextureView / delegate 全部重建 → 黑屏 1~3 秒再重新取流。
            这一条与点播那两条现在完全相同，见 `直播优化-PiP稳定性对比-说明.md` ②-1。
          · exported=false：只允许 App 内部显式 Intent 拉起（CoverViewModel 用 setClassName）
          · theme 沿用应用主题；页面自己在代码里把 windowBackground 刷成纯黑（盖掉 splash）
        -->
        <activity
            android:name=".LivePlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Bilimiao" />

        <!--
          点播播放页（阶段 1 新增，独立 Activity）。
          为什么独立：见 `直播优化-点播PIP立即开启-说明.md` §7.3 —— PiP 只能弹**栈顶** Activity，
          而点播播放器原来活在 task 根 MainActivity 自己里，一进小窗下面没有自家页面，只能露出桌面。
          本页压在 MainActivity（视频详情页）之上，于是 PiP 时详情页留在屏幕上（与直播同一套结构）。
          · supportsPictureInPicture：点播的画中画
          · configChanges 里的 orientation|screenSize|...：转屏/进出 PiP **不重建** Activity
            （重建会把播放器 View 一起丢掉，画面必然黑一下，不能接受）
          · launchMode=singleTop：已在栈顶时再"打开一个视频"走 onNewIntent 就地换源，不叠第二个播放器
          · exported=false：只允许 App 内部显式 Intent 拉起（VideoPlayerLauncher）
          · theme 沿用应用主题；页面自己在代码里把 windowBackground 刷成纯黑（盖掉 splash）
        -->
        <activity
            android:name=".VideoPlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Bilimiao" />

        <!-- dataSync：下载时长任务，退到后台不能被系统回收（否则下载半截 + 通知永久卡住） -->
        <service
            android:name="cn.a10miaomiao.bilimiao.download.DownloadService"
            android:foregroundServiceType="dataSync"/>
        <service
            android:name=".service.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:permission="android.permission.BIND_MEDIA_BROWSER_SERVICE">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
