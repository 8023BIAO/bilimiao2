<?xml version="1.0" encoding="utf-8"?>
<!--
  截图按钮：相机。
  ★ 尺寸/画风对齐官方播放器图标（bili_player_danmaku_is_open.png / ic_player_locked_2.png 等）：
  官方 PNG 是 60x40 画布、描边 3px、纯白不透明；这里用同样的 60x40 画布 + strokeWidth 3，
  配合布局里的 layout_height="20dp"，实际绘制尺寸和官方图标完全一致（30x20dp），
  不会再有"比别的图标小一圈/细一圈"的问题。
-->
