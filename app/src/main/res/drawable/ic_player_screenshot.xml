    <path
        android:pathData="M11,10.5 L19.5,10.5 L22,5.6 Q22.5,4.5 23.7,4.5 L36.3,4.5 Q37.5,4.5 38,5.6 L40.5,10.5 L49,10.5 Q55.5,10.5 55.5,17 L55.5,29 Q55.5,35.5 49,35.5 L11,35.5 Q4.5,35.5 4.5,29 L4.5,17 Q4.5,10.5 11,10.5 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineJoin="round" />
    <!-- 镜头 -->
    <path
        android:pathData="M22.5,23 c0,-4.142 3.358,-7.5 7.5,-7.5 c4.142,0 7.5,3.358 7.5,7.5 c0,4.142 -3.358,7.5 -7.5,7.5 c-4.142,0 -7.5,-3.358 -7.5,-7.5 z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3" />
</vector>
