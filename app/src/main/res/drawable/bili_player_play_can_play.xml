<?xml version="1.0" encoding="utf-8"?>
<!--
  播放（三角）：手绘矢量（老 PNG 是 40x40 位图，放大后发虚）。
  做法：实心三角 + 同色描边(round join) —— 这样三个角是圆的，和原图一致。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="40dp" android:height="40dp"
    android:viewportWidth="40" android:viewportHeight="40">
    <path
        android:pathData="M11.5,7.5 L31.5,20 L11.5,32.5 Z"
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineJoin="round" />
</vector>
